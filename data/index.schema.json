{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oscar-Williams/dsh-deepatlas/blob/main/data/index.schema.json",
  "title": "DeepAtlas Evidence v2 ecosystem index",
  "description": "Schema for the native v2 index written by DeepAtlas. Migrated v1 data is represented as legacy-partial evidence inside this v2 envelope.",
  "type": "object",
  "required": ["schemaVersion", "evidenceMeta", "builtAt", "sources", "plugins"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "evidenceMeta": { "$ref": "#/$defs/evidenceMeta" },
    "builtAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceHealth" } },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/plugin" } }
  },
  "$defs": {
    "evidenceMeta": {
      "type": "object",
      "required": ["taxonomyVersion", "extractorVersion", "ruleVersion", "state"],
      "properties": {
        "taxonomyVersion": { "type": "string", "minLength": 1 },
        "extractorVersion": { "type": "string", "minLength": 1 },
        "ruleVersion": { "type": "string", "minLength": 1 },
        "state": { "enum": ["complete", "legacy-partial"] },
        "migratedFrom": { "type": "integer", "const": 1 }
      }
    },
    "sourceHealth": {
      "type": "object",
      "required": ["sourceId", "ok", "itemCount", "fetchedAt"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "itemCount": { "type": "integer", "minimum": 0 },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "mode": { "enum": ["full", "incremental"] },
        "reportedTotal": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "ref": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["commit", "branch", "snapshot"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceId", "sourceKind", "authority", "repository", "observedAt", "originGroup"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceKind": { "enum": ["github-search", "github-contents", "awesome-list", "manifest", "legacy-index"] },
        "authority": { "enum": ["publisher", "platform", "community", "legacy"] },
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "$ref": "#/$defs/ref" },
        "path": { "type": "string" },
        "jsonPointer": { "type": "string" },
        "query": { "type": "string" },
        "observedAt": { "type": "string", "format": "date-time" },
        "upstreamUpdatedAt": { "type": "string" },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "originGroup": { "type": "string", "minLength": 1 }
      }
    },
    "observation": {
      "type": "object",
      "required": ["values", "provenance"],
      "properties": {
        "values": {
          "type": "object",
          "required": ["name", "description", "topics", "provides"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } },
            "provides": { "type": "array", "items": { "type": "string" } }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "atom": {
      "type": "object",
      "required": ["evidenceId", "subject", "polarity", "signal", "provenance", "extractor"],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "subject": { "type": "string", "pattern": "^(capability|field):.+$" },
        "polarity": { "enum": ["supports", "contradicts"] },
        "signal": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["manifest-declaration", "implementation", "exact-topic", "publisher-text", "curation", "legacy"] },
            "matchedAlias": { "type": "string" },
            "rawValue": {},
            "excerpt": { "type": "string" }
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "supersedesEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "extractor": {
          "type": "object",
          "required": ["id", "version", "taxonomyVersion"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "taxonomyVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "decision", "confidence", "supportEvidenceIds", "contradictionEvidenceIds", "computedBy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["accepted", "provisional", "conflicted", "rejected"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "supportEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "contradictionEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
        "computedBy": {
          "type": "object",
          "required": ["ruleVersion", "taxonomyVersion", "extractorVersion"],
          "properties": {
            "ruleVersion": { "type": "string", "minLength": 1 },
            "taxonomyVersion": { "type": "string", "minLength": 1 },
            "extractorVersion": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["schemaVersion", "state", "atoms", "capabilities"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 2 },
        "state": { "enum": ["complete", "legacy-partial"] },
        "atoms": { "type": "array", "items": { "$ref": "#/$defs/atom" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
      }
    },
    "quality": {
      "type": "object",
      "required": ["total", "activity", "community", "trust", "match"],
      "properties": {
        "total": { "type": "number", "minimum": 0, "maximum": 100 },
        "activity": { "type": "number", "minimum": 0, "maximum": 100 },
        "community": { "type": "number", "minimum": 0, "maximum": 100 },
        "trust": { "type": "number", "minimum": 0, "maximum": 100 },
        "match": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "publisherCoverage": {
      "type": "object",
      "required": ["status", "requiredRoles", "fetchedRoles", "errors", "observedAt"],
      "properties": {
        "status": { "enum": ["not-attempted", "complete", "partial", "failed", "not-applicable"] },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "requiredRoles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "fetchedRoles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "errors": { "type": "array", "items": { "type": "string" } },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "plugin": {
      "type": "object",
      "required": ["id", "name", "repoUrl", "description", "type", "stars", "lastPushedAt", "license", "topics", "whitelisted", "provides", "observations", "evidence", "source", "fetchedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "name": { "type": "string" },
        "repoUrl": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "type": { "enum": ["bundle", "cordis", "skill", "unknown"] },
        "kind": { "enum": ["plugin", "framework", "collection", "application", "documentation", "unknown"] },
        "displayName": { "type": "string" },
        "typeSource": { "enum": ["heuristic", "contents"] },
        "stars": { "type": "integer", "minimum": 0 },
        "lastPushedAt": { "type": "string" },
        "license": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } },
        "archived": { "type": "boolean" },
        "fork": { "type": "boolean" },
        "defaultBranch": { "type": "string" },
        "metadataFetchedAt": { "type": "string", "format": "date-time" },
        "deadLink": { "type": "boolean" },
        "whitelisted": { "type": "boolean" },
        "provides": { "type": "array", "items": { "type": "string" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "publisherCoverage": { "$ref": "#/$defs/publisherCoverage" },
        "quality": { "$ref": "#/$defs/quality" },
        "source": { "type": "string" },
        "fetchedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
