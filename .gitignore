# 构建产物:lib/ 必须入库!
# dsh 的 github: 安装是纯 git clone,无构建步骤;本插件不带 prepare 脚本
# (免 allowBuilds 摩擦),因此产物随仓库分发(社区通行做法之一)。
# 发版流程:npm run build → 提交 lib/ → 打 tag。sourcemap 不入库。
lib/**/*.map
dist/

# 依赖
node_modules/

# 本地运行数据(索引与反馈日志不入库)
.run/
*.local.json

# 测试与覆盖率
coverage/

# 环境与编辑器
.env
.env.*
!.env.example
.vscode/
.idea/

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db
.ssh-deploy/
