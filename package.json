{
  "name": "dsh-deepatlas",
  "version": "0.2.2",
  "description": "DeepAtlas (DSH plugin navigator) builds an ecosystem index on request, recommends plugins for the current task, audits risk signals, and installs only with explicit consent. DSH 插件导航：按需建立索引、按任务推荐、审计风险信号、授权安装。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-discovery",
    "plugin-navigation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "scan": "node ./lib/cli.js scan",
    "status": "node ./lib/cli.js status",
    "benchmark:evidence": "npm run build && node ./scripts/evidence-gate.mjs --mode release",
    "benchmark:evidence:fixture": "npm run build && node ./scripts/evidence-gate.mjs --mode release --data-dir ./tests/fixtures/evidence-v2 --no-write",
    "benchmark:evidence:gold": "npm run build && node ./scripts/evidence-gold.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0",
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
